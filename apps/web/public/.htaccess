# DO NOT REMOVE OR MODIFY. Doing so will break the Node.js application.
<IfModule mod_passenger.c>
    PassengerAppEnv production
    PassengerAppRoot "/home/u516356423/public_html"
    PassengerBaseURI "/hcgi"
    PassengerNodejs "/home/u516356423/nodevenv/public_html/22/bin/node"
    PassengerAppType node
    PassengerStartupFile "index.js"
</IfModule>

<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteBase /

	# 1. Canonical Redirect: Route apex domain (gtrendsnow.com) to CDN-accelerated www.gtrendsnow.com
	RewriteCond %{HTTP_HOST} ^gtrendsnow\.com$ [NC]
	RewriteRule ^(.*)$ https://www.gtrendsnow.com/$1 [R=301,L]

	# 2. Exclude backend API routes
	RewriteCond %{REQUEST_URI} ^/hcgi [NC]
	RewriteRule .* - [L]

	# 3. SPA Fallback routing for React Router
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
	Header set X-Powered-By "Hostinger Horizons"

	# Prevent CDN/Proxy caching of index.html so updates are immediately visible
	Header set Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"

	# Cache hashed assets securely for 1 year (immutable)
	<If "%{REQUEST_URI} =~ m#^/assets/.*$#">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</If>
</IfModule>
